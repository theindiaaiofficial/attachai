# Core Origin Configuration (Only variables needed to run & deploy)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

APP_ENV=development
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Optional Admin & Provider Overrides (Safe built-in local defaults are used when left blank)
ADMIN_API_KEY=orbit-dev-admin-key

DATABASE_PROVIDER=sqlite
STORAGE_PROVIDER=local
VECTOR_PROVIDER=local

# Optional Supabase Integration (Leave blank to use built-in SQLite + Local Storage + Local 128-dim Vector)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=knowledge
SUPABASE_VECTOR_DIMENSIONS=128

# Optional External LLM Integration (Leave blank to use built-in LocalConversationalLlm)
LLM_PROVIDER_TYPE=local
LLM_PROVIDER_NAME=local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=128
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

NOTIFICATION_PROVIDER=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ORBIT_RAG_DIAGNOSTICS=0
ORBIT_TEMP_DEBUG_CLIENT_ID=
ORBIT_TEMP_DEBUG_GOUSTO=0
ORBIT_TEMP_DEBUG_LLM_INPUT=0
ORBIT_TEMP_DEBUG_PUREGYM=0

TTS_API_KEY=

MAX_UPLOAD_SIZE_BYTES=10485760
CHUNK_SIZE=900
CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
MAX_HISTORY_MESSAGES=10
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=120
